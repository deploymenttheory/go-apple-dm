  "cards": [
    {
      "dot": "certificate",
      "title": "Server-token setup",
      "items": [
        "The operator uploads the server’s public certificate to the Apple management portal and imports the encrypted .p7m server token.",
        "The dep client uses the resulting OAuth 1.0a credentials; this token is unrelated to an MDM push certificate."
      ]
    },
    {
      "dot": "service",
      "title": "Recurring reconciliation",
      "items": [
        "Inventory starts with a full fetch, then follows incremental cursors. An expired cursor starts a new full fetch.",
        "Profile assignment configures what enrollment profile Apple directs the device to use; the device must still complete enrollment."
      ]
    },
    {
      "dot": "transport",
      "title": "Public documentation",
      "items": [
        "Device assignment — https://developer.apple.com/documentation/devicemanagement/device-assignment"
      ]
    }
