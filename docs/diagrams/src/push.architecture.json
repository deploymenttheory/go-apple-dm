    {
      "dot": "cyan",
      "title": "Send path",
      "items": [
        "Notifier reads push info from storage, then sends one push per Target",
        "A burst for one enrollment collapses into a single push"
      ]
    },
    {
      "dot": "rose",
      "title": "Push outcomes",
      "items": [
        "A 410 publishes PushTokenInvalid; the caller decides how to retire stored tokens",
        "Transient failures are distinct from invalid-token outcomes"
      ]
