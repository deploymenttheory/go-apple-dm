  "cards": [
    {
      "dot": "cyan",
      "title": "Three services, three auth schemes",
      "items": [
        "DEP uses OAuth 1.0a with a server token from the portal exchange",
        "Business Manager uses an ES256 client assertion",
        "The software lookup service needs no credentials at all"
      ]
    },
    {
      "dot": "emerald",
      "title": "Assignment",
      "items": [
        "The syncer pages by cursor and handles cursor expiry by refetching",
        "The assigner is state-driven and reads back what Apple recorded",
        "A 429 backs the account off rather than hammering the endpoint"
      ]
    },
    {
      "dot": "rose",
      "title": "Software update gate",
      "items": [
        "An old OS is refused with ErrorCodeCodeSoftwareUpdateRequired (com.apple.softwareupdate.required)",
        "gdmf answers what the latest version is for that device"
      ]
    }
  ]
