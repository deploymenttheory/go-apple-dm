  "cards": [
    {
      "dot": "authentication",
      "title": "Discovery and authentication",
      "items": [
        "The well-known response advertises an enrollment type and service URL. DM_DISCOVERY selects the route by model family.",
        "An unauthenticated request receives the configured authentication challenge. The resulting access token remains reusable until expiry or invalidation."
      ]
    },
    {
      "dot": "policy",
      "title": "Identity and channel checks",
      "items": [
        "Trusted SCEP or ACME issuance registers the certificate/account association. Service hooks reserve and confirm that association around enrollment persistence.",
        "macOS device-channel requests omit the bearer token; applicable account channels require it and may receive a reauthentication challenge."
      ]
    },
    {
      "dot": "success",
      "title": "Completed enrollment",
      "items": [
        "After obtaining its certificate, the device sends Authenticate and TokenUpdate. The latter stores push details and enables the channel."
      ]
    },
    {
      "dot": "transport",
      "title": "Public documentation",
      "items": [
        "Onboarding users with account-driven enrollment — https://developer.apple.com/documentation/devicemanagement/onboarding-users-with-account-driven-enrollment",
        "Deploying device management enrollment profiles — https://developer.apple.com/documentation/devicemanagement/deploying-device-management-enrollment-profiles",
        "MDM payload — https://developer.apple.com/documentation/devicemanagement/mdm"
      ]
    }
  ]
