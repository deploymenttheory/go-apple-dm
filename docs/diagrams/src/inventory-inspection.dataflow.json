  "cards": [
    {
      "dot": "policy",
      "title": "Explicit access",
      "items": [
        "readInventory exposes metadata and checked links. readRawInventory permits originals, history and arbitrary source mappings.",
        "Raw JSON and NDJSON exports carry exact original_json bytes. ABM acceptance matches the current synchronization generation and complete coverage membership; prior history cannot satisfy those assertions."
      ]
    },
    {
      "dot": "storage",
      "title": "Evidence survives resolution",
      "items": [
        "Omission retains earlier native values. False, zero, null and empty arrays remain values; all candidates keep provenance.",
        "Idle cannot qualify stored hardware. Pending replacement waits for active pin. Serial omission needs a genuine binding; backfill preserves provenance."
      ]
    },
    {
      "dot": "service",
      "title": "Implementation",
      "items": [
        "native: Native device report — https://github.com/deploymenttheory/go-apple-dm/blob/da9ffc5ff613d47d0153f82ce8c7ab59b8f73d01/server/internal/app/inventory.go",
        "cloudEvidence: Apple source evidence — https://github.com/deploymenttheory/go-apple-dm/blob/da9ffc5ff613d47d0153f82ce8c7ab59b8f73d01/devicemanagement/inventory/records.go",
        "nativeEvidence: Native source evidence — https://github.com/deploymenttheory/go-apple-dm/blob/da9ffc5ff613d47d0153f82ce8c7ab59b8f73d01/server/internal/app/inventory.go",
        "correlate: Correlate serials — https://github.com/deploymenttheory/go-apple-dm/blob/da9ffc5ff613d47d0153f82ce8c7ab59b8f73d01/devicemanagement/inventory/records.go",
        "resolve: Resolve declared paths — https://github.com/deploymenttheory/go-apple-dm/blob/da9ffc5ff613d47d0153f82ce8c7ab59b8f73d01/server/internal/app/inventory_inspection.go",
        "Raw source export — https://github.com/deploymenttheory/go-apple-dm/blob/da9ffc5ff613d47d0153f82ce8c7ab59b8f73d01/devicemanagement/inventory/views.go",
        "ABM acceptance — https://github.com/deploymenttheory/go-apple-dm/blob/da9ffc5ff613d47d0153f82ce8c7ab59b8f73d01/server/lab/live_abm.go"
      ]
    }
