  "cards": [
    {
      "dot": "authentication",
      "title": "Two verification stages",
      "items": [
        "Challenge processing verifies the Apple attestation chain, freshness, required device identifiers, and configured admission policy.",
        "Finalization verifies the certificate signing request and checks that its public key matches the attested key."
      ]
    },
    {
      "dot": "certificate",
      "title": "Certificate retrieval",
      "items": [
        "Signed requests consume one-use replay nonces. A finalized order provides a certificate URL that the client retrieves using POST-as-GET.",
        "SCEP and ACME identity issuance are independent of the HTTPS trust anchors distributed for enrollment endpoints."
      ]
    },
    {
      "dot": "transport",
      "title": "Public documentation",
