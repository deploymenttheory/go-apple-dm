  "cards": [
    {
      "dot": "policy",
      "title": "Two authorization paths",
      "items": [
        "The static DM_ADMIN_TOKEN is checked first and grants root authority without Cedar. Stored-principal tokens are authenticated and authorized against policy.",
        "Each registered admin route declares an action. Policy editing requires root independently of Cedar."
      ]
    },
    {
      "dot": "transport",
      "title": "Current route coverage",
      "items": [
        "Routes include MDM commands and results, declarative state, Apple service clients, certificates, audit, and principal administration.",
        "PRs 12 and 14 add app push credentials and sends, enrollment-profile issuance, enrollment evidence, and controlled replacement."
      ]
    },
    {
      "dot": "authentication",
      "title": "CLI credentials",
      "items": [
        "Reference tokens through a protected file or environment variable. The config rejects group and other permission bits.",
        "Offline explanation and local bench supervision do not follow this HTTP request path."
      ]
    },
    {
      "dot": "transport",
      "title": "Public documentation",
      "items": [
        "Cedar authorization overview — https://docs.cedarpolicy.com/",
        "Sending MDM commands to a device — https://developer.apple.com/documentation/devicemanagement/sending-mdm-commands-to-a-device",
        "Deploying device management enrollment profiles — https://developer.apple.com/documentation/devicemanagement/deploying-device-management-enrollment-profiles"
      ]
    }
