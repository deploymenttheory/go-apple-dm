  "cards": [
    {
      "dot": "cyan",
      "title": "Every admin request",
      "items": [
        "Bearer, then a principal, then a policy decision, then the handler",
        "Families include mdm, ddm, dep, axm, acme, pki, principals, audit and introspection",
        "A route with no action is a build error, not a runtime one"
      ]
    },
    {
      "dot": "rose",
      "title": "Bootstrap authority",
      "items": [
        "The static token is compared first, in constant time, so it works when the principal store is empty or unreachable",
        "It authenticates as root and bypasses Cedar entirely",
        "Policy editing is gated on root in Go, outside Cedar, because a policy that can edit policies could grant itself anything"
      ]
    },
    {
      "dot": "emerald",
      "title": "Credentials by reference",
      "items": [
        "Use @file or env:NAME references; literal token arguments may appear in process listings",
        "A config file with any group or other permission bits is refused",
        "Token creation prints the credential to stdout; protect captured output"
      ]
    }
  ]
