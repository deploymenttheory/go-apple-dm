  "cards": [
    {
      "dot": "cyan",
      "title": "Four endpoints, one URL",
      "items": [
        "The device never gets a DDM URL: every call is a check-in message to /mdm",
        "tokens, declaration-items, declaration/{kind}/{identifier}, status"
      ]
    },
    {
      "dot": "rose",
      "title": "Change to command",
      "items": [
        "The engine no longer calls back into the notifier: the change rows are the durable signal",
        "Its Enqueuer is service.Core, so a DDM kick runs the hooks and the target screen like any command"
      ]
    }
  ]
