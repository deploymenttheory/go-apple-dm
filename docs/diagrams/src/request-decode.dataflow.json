  "cards": [
    {
      "dot": "cyan",
      "title": "One codec boundary",
      "items": [
        "plist is the library's only point of contact with property lists",
        "The decoder is byte- and depth-limited because device input is untrusted"
      ]
    },
    {
      "dot": "rose",
      "title": "Identity",
      "items": [
        "The certificate comes from TLS, a proxy header, or the detached Mdm-Signature",
        "Whichever the source, it is pinned to the enrollment and checked on every later message"
      ]
    },
    {
      "dot": "amber",
      "title": "Not here",
      "items": [
        "schema/support screens outbound commands, not decoded check-ins",
        "That screen is in flow-command-delivery, on service.Core.Enqueue"
      ]
    }
  ]
