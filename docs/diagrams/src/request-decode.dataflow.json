      "row": 0,
      "tag": "untrusted",
      "width": 130
    },
    {
      "id": "signature",
      "type": "security",
      "label": "Mdm-Signature",
      "sublabel": "detached CMS",
      "stage": 0,
      "row": 1,
      "tag": "untrusted",
      "width": 130
    },
    {
      "id": "plist",
      "type": "backend",
      "label": "plist.Decoder",
      "sublabel": "byte and depth bounded",
      "stage": 1,
      "row": 0,
      "width": 130
    },
    {
      "id": "cms",
      "type": "security",
      "label": "cms.VerifyHeader",
      "sublabel": "skew tolerance",
      "stage": 1,
      "row": 1,
      "width": 130
    },
    {
      "id": "checkin",
      "type": "backend",
      "label": "mdm.Checkin",
      "sublabel": "one of eight messages",
      "stage": 2,
      "row": 0,
      "width": 130
