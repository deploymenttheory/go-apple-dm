      "variant": "security",
      "route": "straight"
    },
    {
      "from": "plist",
      "to": "checkin",
      "label": "check-in",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "from": "plist",
      "to": "response",
      "label": "response",
      "variant": "default"
    },
    {
      "from": "cms",
      "to": "cert",
