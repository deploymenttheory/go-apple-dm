  "cards": [
    {
      "dot": "cyan",
      "title": "Deliberately decoupled",
      "items": [
        "The engine writes change rows inside its transaction and never calls back into the notifier",
        "The notifier drains them on a 1s poll; the admin route wrapper Kicks it so the poll is not the only trigger"
      ]
    },
    {
      "dot": "emerald",
      "title": "Through the command path",
      "items": [
        "The notifier's Enqueuer is service.Core, so a DDM kick runs the hooks, the target screen and the audit trail",
        "One DeclarativeManagement command per enrollment, under the dedupe key ddm"
      ]
    }
  ]
