  "cards": [
    {
      "dot": "cyan",
      "title": "One contract, five backends",
      "items": [
        "In-memory, SQLite (pure Go), PostgreSQL and MySQL all run the same suite",
        "A Failing wrapper injects an error by method name for failing-path tests"
      ]
    },
    {
      "dot": "rose",
      "title": "Errors are sentinels",
      "items": [
        "ErrNotFound, ErrDisabled, ErrConflict and ErrInvalid are the whole vocabulary",
        "A driver's unique-violation is mapped to ErrConflict by the Dialect"
      ]
    }
