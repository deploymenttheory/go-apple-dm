  "cards": [
    {
      "dot": "cyan",
      "title": "Composed, not monolithic",
      "items": [
        "One backend satisfies all eight; a caller depends only on the part it needs",
        "Every backend runs the same contract suite, so the split is enforced not merely documented"
      ]
    },
    {
      "dot": "rose",
      "title": "Sentinels",
      "items": [
        "ErrNotFound, ErrDisabled, ErrConflict and ErrInvalid are the whole error vocabulary",
        "Re-enrollment clears push info, tokens, the pin and the pending queue in one transaction"
      ]
    }
