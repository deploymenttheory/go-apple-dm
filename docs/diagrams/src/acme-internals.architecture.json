        "id": "signed",
        "label": "Signed ACME requests",
        "focus": [
          "device",
          "server",
          "jose",
          "nonces"
        ],
        "note": "New-account identifies its key with a JWK; later requests use the account key ID. The server consumes each replay nonce once."
      },
      {
        "id": "order",
        "label": "Create an order",
        "focus": [
          "server",
          "orders",
          "identifiers",
          "store"
        ],
        "note": "An enrollment identifier binds the order to its intended device and is claimed once."
      },
      {
        "id": "attestation",
        "label": "Verify and authorize",
        "focus": [
          "server",
          "attest",
          "policy",
          "capkg"
        ],
        "note": "Validate Apple attestation and admission policy. Finalization separately proves that the CSR uses the attested key."
      },
      {
        "id": "refused",
        "label": "Protocol errors",
        "focus": [
          "attest",
          "policy",
          "problem"
        ],
        "note": "ACME handlers return problem documents for protocol failures; HTTP transport and proxy failures are outside that contract."
      }
    ],
