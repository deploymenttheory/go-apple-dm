        "id": "order",
        "label": "Order",
        "focus": [
          "server",
          "orders",
          "identifiers",
          "store"
        ],
        "note": "One permanent-identifier, claimed once and bound to a specific device."
      },
      {
        "id": "attestation",
        "label": "Attestation",
        "focus": [
          "server",
          "attest",
          "policy",
          "capkg"
        ],
        "note": "Chain, freshness, attested key and device binding, then a policy decision."
      },
      {
        "id": "refused",
        "label": "Refusal",
        "focus": [
          "attest",
          "policy",
          "problem"
        ],
        "note": "Every refusal leaves as an RFC 7807 problem document."
      }
    ]
