  "cards": [
    {
      "dot": "authentication",
      "title": "What attestation proves",
      "items": [
        "The server verifies Apple attestation evidence, challenge freshness, and the expected device identity before applying admission policy.",
        "At finalization, the certificate signing request must use the attested key. Accepting a challenge does not itself issue a certificate."
      ]
    },
    {
      "dot": "policy",
      "title": "Protocol and policy",
      "items": [
        "Signed requests use one-use replay nonces. Orders and identifiers are persisted so concurrent requests cannot reuse an authorization.",
        "ACME protocol failures use problem documents. Optional issuance registration and revocation add certificate-status tracking."
      ]
    },
    {
      "dot": "transport",
      "title": "Public documentation",
      "items": [
        "ACMECertificate — https://developer.apple.com/documentation/devicemanagement/acmecertificate",
        "Deploy Managed Device Attestation — https://support.apple.com/en-gb/guide/deployment/dep54e5ac1fd/web",
        "RFC 8555 — ACME — https://www.rfc-editor.org/rfc/rfc8555"
      ]
    }
  ]
