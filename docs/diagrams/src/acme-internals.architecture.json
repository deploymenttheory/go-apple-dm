  "cards": [
    {
      "dot": "cyan",
      "title": "Four checks before a certificate",
      "items": [
        "The chain verifies to the Apple Enterprise Attestation Root",
        "Freshness comes from the challenge token, the attested key must be the CSR key, and the attestation must name the bound device"
      ]
    },
    {
      "dot": "rose",
      "title": "Refusal is a document",
      "items": [
        "Every failure leaves as an RFC 7807 problem, never a bare status",
        "The subject comes from the binding, never from the CSR"
      ]
    }
  ]
