  "cards": [
    {
      "dot": "cyan",
      "title": "Two lanes, one handler",
      "items": [
        "POST is the token lane and finishes immediately",
        "GET is the configuration_web_url lane and resumes after OIDC"
      ]
    },
    {
      "dot": "emerald",
      "title": "The update gate",
      "items": [
        "An old OS is refused with ErrorCodeCodeSoftwareUpdateRequired",
        "The catalogue is cached with a TTL and serves last-good on a refresh failure"
      ]
    }
  ]
