    {
      "id": "authenticate",
      "from": "device",
      "to": "core",
      "y": 419.0,
      "label": "Authenticate",
      "variant": "emphasis"
    },
    {
      "id": "pinned",
      "from": "core",
      "to": "device",
      "y": 449.5,
      "label": "certificate pinned",
      "variant": "return"
    },
    {
      "id": "tokenupdate",
      "from": "device",
      "to": "core",
      "y": 480.0,
      "label": "TokenUpdate enables the enrollment",
      "variant": "emphasis"
    }
