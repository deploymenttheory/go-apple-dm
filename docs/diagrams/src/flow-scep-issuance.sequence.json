  "cards": [
    {
      "dot": "cyan",
      "title": "Challenge strategies",
      "items": [
        "A static shared password from MDM_SCEP_CHALLENGE",
        "An HMAC password minted per device when MDM_SCEP_HMAC_KEY is set, and re-derived from the CSR common name"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure is still a 200",
      "items": [
        "A refusal is a signed CertRep with a failInfo, not an HTTP error",
        "The device reads failInfo to learn why"
      ]
    }
  ]
