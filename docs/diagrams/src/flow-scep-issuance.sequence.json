  "cards": [
    {
      "dot": "policy",
      "title": "Issuance authorization",
      "items": [
        "The profile selects the SCEP endpoint and challenge. Static and HMAC challenges are traditional strategies; account and replacement credentials bind issuance to an authorized request.",
        "A successful challenge permits CSR validation and signing; it does not itself issue the certificate."
      ]
    },
    {
      "dot": "service",
      "title": "Success, failure, and renewal",
      "items": [
        "Successful issuance returns the device identity in a signed CertRep. Protocol rejection instead returns failInfo; malformed transport input may fail earlier.",
        "An accepted renewal proves possession with the existing certificate and can bypass the initial challenge. Configured certificate-status checks still apply."
      ]
    },
    {
      "dot": "authentication",
      "title": "Enrollment association",
      "items": [
        "For account enrollment and controlled replacement, trusted issuance records the certificate association before the certificate is returned. HTTPS trust is configured separately."
      ]
    },
    {
      "dot": "transport",
      "title": "Public documentation",
