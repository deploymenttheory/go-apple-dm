  "cards": [
    {
      "dot": "cyan",
      "title": "Reading the arrows",
      "items": [
        "Every arrow means \"imports\": the tail depends on the head",
        "Unlabelled arrows carry no meaning beyond that dependency",
        "Left is the composition root, right is the leaf codec"
      ]
    },
    {
      "dot": "rose",
      "title": "Deliberate non-dependencies",
      "items": [
        "push/pushcert is stdlib-only so storage can import it without a cycle",
        "service never imports ddm; the engine arrives as a DMHandler",
        "adapter/proxyclient imports service but not ddm, so the split-deployment boundary is a code boundary"
      ]
    }
  ]
