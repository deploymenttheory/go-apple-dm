# .gitattributes snippet to force users to use same line endings for project.
# 
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

*.json text eol=lf

# Generated diagrams (archify); sources live in docs/diagrams/src
docs/diagrams/*.html linguist-generated=true
docs/diagrams/*.png  linguist-generated=true
docs/diagrams/*.png  binary
